# ---------- Runtime ----------
NODE_ENV=development
PORT=5000

# ---------- Database ----------
# Render gives you an "Internal Database URL" for production.
DATABASE_URL=your_postgresql_connection_string
# Set to true if your provider requires TLS and uses its own CA (Render external URL, Supabase, Neon...).
DATABASE_SSL=false

# ---------- Secrets (generate each one separately; >= 32 chars in production) ----------
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=your_secure_session_secret
ADMIN_SESSION_SECRET=your_separate_admin_session_secret
CSRF_SECRET=your_csrf_secret

# ---------- Frontend origins (exact origins, no trailing slash, https in production) ----------
# Primary origins for links in emails and standard redirects.
FRONTEND_URL=http://localhost:5500
ADMIN_FRONTEND_URL=http://localhost:5501
# Comma-separated list of all origins allowed to make API requests (CORS/CSRF).
# Include your production domains, admin domain, and localhost for dev.
# Example: https://osasweather-weather-app.vercel.app,https://osasweather-admin-app.vercel.app
ALLOWED_ORIGINS=http://localhost:5500,http://localhost:5501

# ---------- Cookies ----------
# 'lax' works when frontends and API share a registrable domain (e.g. osasweather.com).
# Use 'none' (and ensure DATABASE_SSL=true/https) if frontends are on different sites (e.g. Vercel vs Render).
COOKIE_SAMESITE=lax

# ---------- Weather providers ----------
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1/forecast
GEOCODING_API_URL=https://geocoding-api.open-meteo.com/v1/search
WEATHER_TIMEOUT_MS=8000

# ---------- Email (SMTP) for password reset ----------
# Without these, reset emails are NOT sent. Use a provider you have verified (Resend, Brevo, Mailgun, SES...).
EMAIL_HOST=your_email_host
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email_username
EMAIL_PASSWORD=your_email_password
EMAIL_FROM=your_verified_sender_address
# Development only: print reset links to the console instead of emailing. Ignored in production.
DEV_LOG_RESET_LINKS=false

# ---------- Owner administrator bootstrap (used ONLY by `npm run bootstrap-owner`) ----------
OWNER_ADMIN_EMAIL=
# Random, >= 24 chars. Remove from the environment after the owner is created.
OWNER_BOOTSTRAP_SECRET=your_random_bootstrap_secret
# Optional, non-interactive bootstrap only. Remove immediately after use.
# OWNER_INITIAL_PASSWORD=your_initial_password

# ---------- Rate limits (defaults shown; per window) ----------
# RL_GLOBAL=600   RL_LOGIN=10   RL_ADMIN_LOGIN=5   RL_REGISTER=10   RL_FORGOT=5   RL_WEATHER=120
