{
  "name": "osasweather",
  "private": true,
  "description": "Repository-level tooling only (CSS build + vendoring). The apps themselves need no build step except the tiny API-URL config step on Vercel.",
  "scripts": {
    "vendor": "node scripts/vendor.js",
    "build:css": "node scripts/build-css.js",
    "build": "npm run vendor && npm run build:css",
    "serve:weather": "node scripts/static-server.js weather-app 5500",
    "serve:admin": "node scripts/static-server.js admin-app 5501 admin-login.html"
  },
  "devDependencies": {
    "@fontsource-variable/sora": "^5.1.0",
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.11.3",
    "chart.js": "^4.4.7",
    "sass": "^1.83.0",
    "subset-font": "^2.9.0",
    "tailwindcss": "^3.4.17"
  }
}
